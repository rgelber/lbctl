#!/usr/bin/env python3
"""Gracefully disable an F5 BIG-IP pool member for maintenance.

Flow for `disable`:
  1. Set the member's session to "user-disabled" (it leaves load-balancing
     rotation; the health monitor no longer governs it, so no monitor
     "failure" is generated while the node comes out).
  2. Wait for active connections to drain to zero (configurable timeout).

`enable` flips the session state back ("user-enabled") to bring a node back
into service. `disable` also covers a quick drain (with --max-wait 0), where
you just want to pull a node out of rotation without waiting. `status`
reports current state for one member (--member) or, if --member is omitted,
every member in the pool.

`list-partitions`, `list-pools`, and `list-members` are read-only discovery
commands: they list the administrative partitions, pools, and pool members
visible with the configured credentials, so you can find the exact
`--partition`/`--pool`/`--member` values to target before running
`status`/`disable`/`enable`.

`--member`/`-m` accepts either the member's IP address or its BIG-IP node
name -- pool members are often created against a named node rather than a
raw IP, so this lets you target one the same way you'd refer to it in the
F5 UI, without having to look up its IP or port first. A port is only
needed (as `name:port`) if a pool happens to have the same node/IP on more
than one port.
"""
import argparse
import base64
import getpass
import json
import os
import re
import ssl
import sys
import time
import urllib.error
import urllib.request

try:
    import tomllib  # stdlib, Python 3.11+
except ImportError:
    tomllib = None

